# --- LLM (OpenAI) ---
OPENAI_API_KEY=

# Model tiers (optional overrides)
OPENAI_MODEL=gpt-5.4          # strong tier: planning, reflection, synthesis (direct fallback)
RESEARCHER_MODEL=gpt-5.1      # medium tier: research subagents
EXTRACTOR_MODEL=             # cheap/fast tier: structured-output extraction (defaults to RESEARCHER_MODEL)
ANALYZER_MODEL=              # A2A Analyzer agent: formats the final report (defaults to RESEARCHER_MODEL — lighter than OPENAI_MODEL)
COLLECTOR_MODEL=             # A2A Collector agent: relays findings (defaults to EXTRACTOR_MODEL / cheap tier)

# --- Agent-to-agent synthesis (A2A protocol, @a2a-js/sdk) ---
RESEARCH_USE_A2A=1           # 1 (default) routes synthesis through the Collector<->Analyzer A2A loop; 0 = direct in-process synthesis
A2A_ANALYZER_PORT=41241      # loopback port for the in-process Analyzer A2A server
# A2A_ANALYZER_URL=          # override the full Analyzer base URL (defaults to http://127.0.0.1:$A2A_ANALYZER_PORT/)

# --- Search providers (configure at least one) ---
TAVILY_API_KEY=              # primary web search + extract
EXA_API_KEY=                 # neural search / find-similar / fallback

# --- External-call rate limiting (proactive throttle on provider calls) ---
SEARCH_MIN_INTERVAL_MS=250   # min ms between calls to a search provider (default 250)
# EXA_MIN_INTERVAL_MS=       # per-provider override (defaults to SEARCH_MIN_INTERVAL_MS)
# TAVILY_MIN_INTERVAL_MS=    # per-provider override (defaults to SEARCH_MIN_INTERVAL_MS)

# --- Observability ---
LOG_LEVEL=info               # debug | info | warn | error
# LOG_PRETTY=1               # 1 for human-readable logs in local dev (default: JSON lines)

# --- Research engine tuning (optional) ---
RESEARCH_CONCURRENCY=3       # max subagents running at once
RESEARCH_MAX_WAVES=2         # wave 1 + up to (N-1) reflection-driven follow-up waves
RESEARCH_MAX_FOLLOWUPS=3     # gaps investigated per reflection wave

# --- Durable jobs (Phase 3: run `docker compose up -d` first) ---
DATABASE_URL=postgresql://research:research@localhost:5432/deep_research
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2         # jobs processed in parallel by the worker
RESEARCH_CHECKPOINTER=0      # 1 to enable the LangGraph Postgres checkpointer (opt-in)
RESEARCH_TOKEN_BUDGET=0      # stop launching follow-up waves past this many tokens (0 = unlimited)
CACHE_TTL_SECONDS=86400      # Redis L2 cache TTL for search results + fetched content
